# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://afterprint:afterprint_dev@localhost:5432/afterprint

# ─── Web (CORS) ─────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000

# ─── Object Storage (MinIO for local dev) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=afterprint-originals
S3_ACCESS_KEY=afterprint
S3_SECRET_KEY=afterprint_dev_secret
# S3_KMS_KEY=         # Set in production for envelope encryption

# ─── Redis / BullMQ ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Afterprint AI service ──────────────────────────────────────────────────
AI_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-to-a-32-char-plus-random-secret

# ─── Stellar ────────────────────────────────────────────────────────────────
# STELLAR_NETWORK=testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_EVIDENCE_ANCHOR_CONTRACT=<contract_id>
# STELLAR_CUSTODY_CONTRACT=<contract_id>
# STELLAR_SIGNER_SECRET=<secret_key>  # never commit this
# STELLAR_ANCHOR_SERVICE_URL=         # optional sidecar signing service

# ─── Malware scanning (ClamAV) ──────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ─── Upload limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600   # 100 MB

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
